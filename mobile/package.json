{
  "name": "sanitaryware-crm-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "node scripts/android-build-env.mjs expo run:android",
    "export:android": "expo export --platform android --output-dir dist-check-current --clear",
    "build:android:debug": "node scripts/android-build-env.mjs gradle assembleDebug",
    "build:android:release": "node scripts/android-build-env.mjs gradle assembleRelease",
    "ui:smoke": "node scripts/ui-smoke-test.mjs",
    "web": "expo start --web --port 8082",
    "lint": "eslint .",
    "test": "node --test src/utils/*.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "axios": "^1.16.1",
    "expo": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^10.4.0",
    "playwright": "^1.60.0"
  }
}
