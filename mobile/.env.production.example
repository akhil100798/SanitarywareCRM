# ==============================================================================
# Sanitaryware CRM — Mobile Android Production Environment Template
# ==============================================================================

# Production API Endpoint (FQDN with HTTPS)
EXPO_PUBLIC_API_BASE_URL=https://crm.yourcompany.com/api

# Optional: Android Release Signing Keystore Configuration
# Provide these environment variables when assembling signed release APK/AAB
CR_KEYSTORE_PATH=./crm-release.keystore
CR_KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
CR_KEY_ALIAS=crm-release-key
CR_KEY_PASSWORD=YOUR_KEY_PASSWORD
