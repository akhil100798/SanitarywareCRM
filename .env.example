# ==============================================================================
# Sanitaryware CRM — Environment Configuration Template
# COPY this file to .env or .env.production and populate with secure, environment-specific values.
#
# CRITICAL SECURITY DIRECTIVES:
# 1. NEVER commit real secrets, private keys, or passwords to version control.
# 2. In production, set file permissions to 600 (chmod 600 .env).
# 3. Use strong, randomly generated secrets (min 32 characters for JWT).
# ==============================================================================

# --- Server & Runtime Profile ---
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=prod

# --- Production / Staging Database Connection ---
# Managed MySQL or local container endpoint. In production, enforce SSL (sslMode=VERIFY_IDENTITY).
DATABASE_URL=jdbc:mysql://prod-db-host:3306/sanitaryware_crm?sslMode=VERIFY_IDENTITY&allowPublicKeyRetrieval=false
DATABASE_USERNAME=crm_db_user
DATABASE_PASSWORD=REPLACE_WITH_SECURE_DATABASE_PASSWORD

# --- MySQL Container Deployment Variables (docker-compose.staging.yml) ---
MYSQL_ROOT_PASSWORD=REPLACE_WITH_SECURE_ROOT_PASSWORD
MYSQL_DATABASE=sanitaryware_crm
MYSQL_USER=crm_db_user
MYSQL_PASSWORD=REPLACE_WITH_SECURE_DATABASE_PASSWORD

# --- JWT Authentication ---
# Cryptographically secure random secret key (minimum 32 characters / 256 bits).
# Generate using: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_VERY_LONG_SECURE_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRATION_MS=86400000

# --- CORS & Domain Whitelist ---
# Comma-separated list of exact allowed origin URLs. NEVER use wildcards (*) in production.
CORS_ALLOWED_ORIGIN_PATTERNS=https://crm.yourcompany.com,https://admin.yourcompany.com

# --- Multipart File Uploads & Local Storage Volume ---
FILE_UPLOAD_DIR=/app/uploads
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=160MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=161MB

# --- Redis Scalable Rate Limiting (Optional: memory | redis) ---
# When set to redis, Spring Boot uses Redis for sliding-window rate limiting.
RATE_LIMITER_STORE=memory
SPRING_DATA_REDIS_HOST=redis-cluster.internal
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD_IF_CONFIGURED

# --- Security Rate Limiting Parameters ---
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# --- Email Notifications SMTP (Optional) ---
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=REPLACE_WITH_SMTP_API_KEY

# --- WhatsApp Business via Twilio (Optional) ---
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Web & Mobile Client API Endpoints ---
VITE_API_BASE_URL=/api
EXPO_PUBLIC_API_BASE_URL=https://crm.yourcompany.com/api

# --- TLS / HTTPS Reverse Proxy Certificates ---
SSL_CERT_PATH=/etc/letsencrypt/live/crm.yourcompany.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/crm.yourcompany.com/privkey.pem
