# ==============================================================================
# Sanitaryware CRM — Production Environment Configuration Template
# COPY this file to .env.production on your deployment server and populate with
# real, cryptographically secure production values.
#
# CRITICAL SECURITY DIRECTIVES:
# 1. NEVER commit .env.production to source control.
# 2. NEVER reuse development/staging passwords or default placeholder strings.
# 3. Ensure this file on the production server has permissions 600 (chmod 600).
# ==============================================================================

# --- Server & Runtime ---
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=prod

# --- Production Database Connection ---
# Use a fully-qualified domain name or VPC private endpoint for your managed MySQL 8.4 instance.
# Enforce SSL with sslMode=VERIFY_IDENTITY (or REQUIRED depending on certificate topology).
DATABASE_URL=jdbc:mysql://prod-db-cluster.internal:3306/sanitaryware_crm_prod?sslMode=VERIFY_IDENTITY&allowPublicKeyRetrieval=false
DATABASE_USERNAME=crm_prod_user
DATABASE_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_MIN_16_CHARS

# --- JWT Authentication ---
# Generate a cryptographically secure random secret of at least 32 characters (256-bit key).
# Example command: openssl rand -base64 48
JWT_SECRET=GENERATE_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_MIN_32_CHARS
# Token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# --- CORS & Domain Whitelist ---
# Comma-separated list of exact production HTTPS origins permitted to make authenticated API requests.
# NEVER use wildcard (*) or localhost in production.
CORS_ALLOWED_ORIGIN_PATTERNS=https://crm.yourcompany.com,https://admin.yourcompany.com

# --- Multipart File Uploads & Storage Volume ---
# Directory mounted to persistent Docker volume (backend_prod_uploads:/app/uploads)
FILE_UPLOAD_DIR=/app/uploads
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=160MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=161MB

# --- Security Rate Limiting ---
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# --- Email Notification SMTP (Optional / Production) ---
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=YOUR_SENDGRID_OR_SMTP_API_KEY

# --- WhatsApp Business Integration via Twilio (Optional / Production) ---
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Web Frontend & Mobile API Endpoints ---
# Reverse-proxy relative path for web; HTTPS FQDN for physical mobile clients
VITE_API_BASE_URL=/api
EXPO_PUBLIC_API_BASE_URL=https://crm.yourcompany.com/api

# --- TLS / HTTPS Reverse Proxy Certificates ---
# Paths on the host system to your production SSL/TLS certificates.
# If omitted or certs are missing, container falls back to built-in self-signed TLS.
SSL_CERT_PATH=/etc/letsencrypt/live/crm.yourcompany.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/crm.yourcompany.com/privkey.pem
